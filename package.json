{
  "name": "@richie696/angular",
  "version": "1.0.0",
  "author": "richie696",
  "description": "Rydeen's Angular Framework",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build framework",
    "build-all": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --code-coverage",
    "test-ci": "ng test --watch=false --browsers=ChromeHeadless --reporters=mocha",
    "coverage": "ng test ngx-translate --code-coverage --watch=false --browsers=ChromeHeadless --reporters=mocha,coverage",
    "lint": "ng lint",
    "nexus-publish": "npm run build && cd dist/framework && npm publish --registry=https://nexus.rydeen.com.cn/repository/npm-rydeen/"
  },
  "dependencies": {
    "@angular/animations": "*",
    "@angular/common": "*",
    "@angular/compiler": "*",
    "@angular/core": "*",
    "@angular/forms": "*",
    "@angular/platform-browser": "*",
    "@angular/platform-browser-dynamic": "*",
    "@angular/router": "*",
    "@ngx-translate/core": "*",
    "@ngx-translate/http-loader": "*",
    "@capacitor-rydeen/preferences": ">=6",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "*"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "*",
    "@angular/cli": "*",
    "@angular/compiler-cli": "*",
    "@types/jasmine": "~5.1.4",
    "angular-eslint": "*",
    "eslint": "^9.16.0",
    "jasmine-core": "~5.4.0",
    "karma": "~6.4.3",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "*",
    "typescript": "*",
    "typescript-eslint": "^8.17.0"
  }
}
