{
  "name": "@richie696/angular",
  "version": "1.0.2",
  "private": true,
  "description": "Angular 22 foundation library monorepo with core services and optional UI adapters.",
  "author": "richie696",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/richie696/richie696-angular-library.git"
  },
  "bugs": { "url": "https://github.com/richie696/richie696-angular-library/issues" },
  "homepage": "https://github.com/richie696/richie696-angular-library#readme",
  "keywords": ["angular", "angular-library", "framework", "typescript", "rxjs", "ui-adapter"],
  "scripts": {
    "changeset:add": "changeset",
    "changeset:status": "changeset status --verbose",
    "version:all": "changeset version && pnpm run toc",
    "toc": "markdown-toc -i \"README.md\" && markdown-toc -i \"projects/framework/README.md\" && markdown-toc -i \"projects/framework-ionic/README.md\" && markdown-toc -i \"projects/framework-material/README.md\" && markdown-toc -i \"projects/framework-primeng/README.md\"",
    "build": "pnpm run toc && pnpm exec ng build framework",
    "build:framework": "pnpm exec ng build framework",
    "build:ionic": "pnpm exec ng build framework-ionic",
    "build:material": "pnpm exec ng build framework-material",
    "build:primeng": "pnpm exec ng build framework-primeng",
    "build-all": "pnpm run toc && pnpm exec ng build framework && pnpm exec ng build framework-ionic && pnpm exec ng build framework-material && pnpm exec ng build framework-primeng",
    "publish:all": "pnpm run publish:selected -- all",
    "publish:selected": "node scripts/publish-selected.js",
    "release:all": "pnpm run version:all && pnpm run publish:all"
  },
  "dependencies": {
    "@angular/common": "~22.1.1",
    "@angular/compiler": "~22.1.1",
    "@angular/core": "~22.1.1",
    "@angular/forms": "~22.1.1",
    "@angular/platform-browser": "~22.1.1",
    "@angular/router": "~22.1.1",
    "@ngx-translate/core": "~18.0.0",
    "@ngx-translate/http-loader": "~18.0.0",
    "@richie696/capacitor-preferences": "~1.0.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~22.1.3",
    "@angular/build": "~22.1.3",
    "@angular/cdk": "~22.1.1",
    "@angular/cli": "~22.1.3",
    "@angular/compiler-cli": "~22.1.1",
    "@angular/material": "~22.1.1",
    "@changesets/cli": "^2.31.0",
    "@ionic/angular": "^8.8.4",
    "@types/jasmine": "~5.1.4",
    "angular-eslint": "*",
    "eslint": "^9.16.0",
    "jasmine-core": "~5.4.0",
    "karma": "~6.4.3",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "markdown-toc": "^1.2.0",
    "ng-packagr": "~22.1.1",
    "primeng": "~22.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.17.0"
  }
}
