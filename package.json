{
  "name": "@richie696/angular",
  "version": "22.1.4",
  "private": true,
  "author": "richie696",
  "license": "MIT",
  "workspaces": [
    "projects/framework",
    "projects/framework-ionic",
    "projects/framework-material",
    "projects/framework-primeng"
  ],
  "scripts": {
    "changeset:add": "changeset",
    "changeset:status": "changeset status --verbose",
    "version:all": "changeset version && npm run toc",
    "toc": "markdown-toc -i \"README.md\" && markdown-toc -i \"projects/framework/README.md\" && markdown-toc -i \"projects/framework-ionic/README.md\" && markdown-toc -i \"projects/framework-material/README.md\" && markdown-toc -i \"projects/framework-primeng/README.md\"",
    "build": "npm run toc && ng build framework",
    "build-all": "npm run toc && ng build framework && ng build framework-ionic && ng build framework-material && ng build framework-primeng",
    "publish:all": "npm run build-all && cd dist/framework && npm publish && cd ../framework-ionic && npm publish && cd ../framework-material && npm publish && cd ../framework-primeng && npm publish",
    "release:all": "npm run version:all && npm run publish:all"
  },
  "dependencies": {
    "@angular/common": "~22.1.1",
    "@angular/compiler": "~22.1.1",
    "@angular/core": "~22.1.1",
    "@angular/forms": "~22.1.1",
    "@angular/platform-browser": "~22.1.1",
    "@angular/router": "~22.1.1",
    "@ngx-translate/core": "~18.0.0",
    "@ngx-translate/http-loader": "~18.0.0",
    "@richie696/capacitor-preferences": "~1.0.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~22.1.3",
    "@angular/build": "~22.1.3",
    "@angular/cdk": "~22.1.1",
    "@angular/cli": "~22.1.3",
    "@angular/compiler-cli": "~22.1.1",
    "@angular/material": "~22.1.1",
    "@changesets/cli": "^2.31.0",
    "@ionic/angular": "^8.8.4",
    "@types/jasmine": "~5.1.4",
    "angular-eslint": "*",
    "eslint": "^9.16.0",
    "jasmine-core": "~5.4.0",
    "karma": "~6.4.3",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "markdown-toc": "^1.2.0",
    "ng-packagr": "~22.1.1",
    "primeng": "~22.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.17.0"
  }
}
